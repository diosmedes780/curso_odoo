<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <record id="wizard_qualification_view_form" model="ir.ui.view">
            <field name="name">Reprobate</field>
            <field name="model">wizard.qualification</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="student_id" readonly="1"/>
                        <field name="note"/>
                    </group>

                    <footer>
                        <button type="object" name="reprobate" string="Reprobate" class="btn btn-primary"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>

</odoo>